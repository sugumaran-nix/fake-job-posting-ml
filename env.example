# ── Flask ─────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_random_hex_string

# Set to "development" to enable Flask debug mode and auto-reload
FLASK_ENV=production

# Port the app listens on
PORT=5000

# ── Admin token ───────────────────────────────────────────────────────
# Protects /select-model and /clear_history from unauthenticated access.
# Leave empty in local dev to disable the check.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=

# ── Rate limiter storage ──────────────────────────────────────────────
# "memory://" works for single-process deployments (gunicorn -w 1).
# For multi-worker: set to redis://localhost:6379/0 and install redis.
RATELIMIT_STORAGE_URI=memory://
